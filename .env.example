# Ручной запуск (docker compose up -d --build). При деплое из GitHub Actions .env
# собирается сам из employees.yml и секретов — этот файл не нужен.

# Вариант 1 — один сотрудник:
TELEGRAM_BOT_TOKEN=
ROUTINE_FIRE_URL=https://api.anthropic.com/v1/claude_code/routines/trig_.../fire
ROUTINE_TOKEN=
BOT_ALLOWED_CHAT_IDS=
BOT_ABOUT=Я помогаю команде с её проектами — могу что-то поменять или добавить.

# Вариант 2 — несколько сотрудников: JSON-массив одной строкой в одинарных кавычках.
# BOT_EMPLOYEES='[{"name":"shop","telegramToken":"...","chatIds":[-100...],"routineFireUrl":"...","routineToken":"...","about":"..."}]'

# Необязательно: имена для обращения без @ и расшифровка голосовых (OpenAI-совместимый STT)
BOT_NAMES=
# STT_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
# STT_API_KEY=
# STT_MODEL=whisper-large-v3-turbo
